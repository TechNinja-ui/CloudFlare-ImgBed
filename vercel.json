{
  "version": 2,
  "buildCommand": "node -e \"console.log('frontend-dist is prebuilt')\"",
  "outputDirectory": "frontend-dist",
  "functions": {
    "api/vercel.js": {
      "maxDuration": 60
    }
  },
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "/api/vercel?__cf_imgbed_path=/api/:path*"
    },
    {
      "source": "/upload/:path*",
      "destination": "/api/vercel?__cf_imgbed_path=/upload/:path*"
    },
    {
      "source": "/file/:path*",
      "destination": "/api/vercel?__cf_imgbed_path=/file/:path*"
    },
    {
      "source": "/dav/:path*",
      "destination": "/api/vercel?__cf_imgbed_path=/dav/:path*"
    },
    {
      "source": "/random/:path*",
      "destination": "/api/vercel?__cf_imgbed_path=/random/:path*"
    },
    {
      "source": "/:path*",
      "destination": "/index.html"
    }
  ]
}
